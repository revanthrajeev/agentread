# AgentRead — environment variables
# Copy to .env.local for development. Only the Supabase block is required to run the app;
# everything else degrades gracefully when unset (see notes per section).

# ---------------------------------------------------------------------------
# Supabase — REQUIRED for auth, dashboard, audits, and usage metering.
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site URL — used for Stripe redirects, share links, and webhook payloads.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Serve middleware (Layer 2). Without this, crawlers get normal HTML — the site
# still works, it just doesn't serve distilled Markdown to agents.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
INTERNAL_SERVE_SECRET=

# Optional. An AgentRead API key (sk-ar-...) that attributes Serve traffic to an
# account, so agent-hit analytics show up on that user's dashboard.
AGENTREAD_API_KEY=

# ===========================================================================
# PAYMENT GATEWAYS
#
# Three are supported, and you do not need all three. Which you need depends on
# where the company is incorporated, because that decides what you can bill in:
#
#   Stripe    Best card conversion worldwide. A Stripe *India* account settles in
#             INR and CANNOT bill in USD, and RBI e-mandate rules make card
#             subscriptions awkward. Billing USD on Stripe needs a non-India entity.
#   PayPal    Works on an Indian export account for cross-border sales. USD only —
#             PayPal discontinued domestic INR payments in India in 2021.
#   Razorpay  Settles into an Indian bank. INR/UPI/netbanking domestically; USD and
#             other currencies via International Payments, which is a SEPARATE
#             activation on your account, approved per business, and can be declined.
#             Generates FIRA/eFIRC automatically, which is what an exporter needs at
#             audit time.
#
# Unset gateways simply aren't offered at checkout. With none set, the app runs as
# free-tier-only and the pricing UI says so rather than showing a button that fails.
# ===========================================================================

# --------------------------- Stripe ----------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
# Webhook endpoint: POST /api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Price IDs (not product IDs) — Stripe Dashboard → Products → Pricing.
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_AUTOFIX=
# Optional per-currency overrides. When set these win over the three above, so a
# single deployment can bill both currencies: STRIPE_PRICE_PRO_USD / _INR, etc.
STRIPE_PRICE_PRO_INR=
STRIPE_PRICE_SCALE_INR=
STRIPE_PRICE_AUTOFIX_INR=

# --------------------------- PayPal ----------------------------------------
# Developer Dashboard → Apps & Credentials. Sandbox and Live have separate creds.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" (exactly) selects production. ANY other value — including a typo or unset —
# routes to sandbox, so a mistake here can never send real money to production.
PAYPAL_ENV=sandbox
# Webhook endpoint: POST /api/billing/webhook/paypal
# Subscribe it to: BILLING.SUBSCRIPTION.ACTIVATED / .UPDATED / .CANCELLED /
# .SUSPENDED / .EXPIRED / .PAYMENT.FAILED and PAYMENT.SALE.COMPLETED.
# Without this id no PayPal webhook can be verified, so none is trusted.
PAYPAL_WEBHOOK_ID=
# Billing plan IDs (P-...), created under a catalog product. USD only.
PAYPAL_PLAN_PRO_USD=
PAYPAL_PLAN_SCALE_USD=
PAYPAL_PLAN_AUTOFIX_USD=

# --------------------------- Razorpay --------------------------------------
# Dashboard → Account & Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Separate secrets for Test and Live.
# Webhook endpoint: POST /api/billing/webhook/razorpay
# Subscribe it to the subscription.* events (activated, charged, cancelled,
# halted, completed, paused, resumed, pending, updated).
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs (plan_...). Razorpay plans are per-currency, so INR and USD are separate
# plans. The USD ones only work once International Payments is live on the account.
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_SCALE_INR=
RAZORPAY_PLAN_AUTOFIX_INR=
RAZORPAY_PLAN_PRO_USD=
RAZORPAY_PLAN_SCALE_USD=
RAZORPAY_PLAN_AUTOFIX_USD=

# ---------------------------------------------------------------------------
# Autofix. Turns audit findings into a GitHub pull request.
#
# Deterministic fixes (llms.txt, robots.txt, Serve middleware) are generated from
# data we already hold and need NEITHER key below — they cost nothing to produce.
# Only fixes that require reading and changing customer source call a model, and
# which key you need depends on the finding: most issues (disabled_cta, lazy_content,
# js_only_content) route to GPT-5 nano/mini for cost — 10-100x cheaper than Opus for a
# scoped single-file patch. The one issue kept on Claude (empty_shell) is the hardest
# case, where patch quality matters more than the marginal cost. See src/lib/fix/router.ts
# for the exact per-issue assignment. Set both keys for full coverage; set only one and
# the other issue types report "not configured" rather than silently failing.
# ---------------------------------------------------------------------------
# console.anthropic.com — required only for the empty_shell fix.
ANTHROPIC_API_KEY=
# platform.openai.com/api-keys — required for every other metered fix (the majority).
OPENAI_API_KEY=

# REQUIRED to connect a GitHub repo. GitHub push tokens are encrypted with
# AES-256-GCM before they touch the database; without this key the app refuses to
# store one at all rather than persisting it in plaintext.
# Generate: openssl rand -base64 48
SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Scheduled monitoring. Point a cron at POST/GET /api/cron/watch hourly with
# `Authorization: Bearer $CRON_SECRET`. Unset = the endpoint returns 503.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# Optional email alerts for watch regressions. Without it, webhook alerts still
# fire and regressions are still recorded on the dashboard.
RESEND_API_KEY=
ALERT_FROM_EMAIL="AgentRead <alerts@agentread.tech>"

# ---------------------------------------------------------------------------
# Error monitoring (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
